# ─────────────────────────────────────────────────────────────
# PANDU Backend Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to GitHub — it contains your secrets!
# ─────────────────────────────────────────────────────────────

# ── Supabase (required) ──────────────────────────────────────
# Get these from: https://supabase.com → your project → Settings → API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here

# ── Local Ollama (default and primary mode) ──────────────────
AI_MODE=local
# Base URL for the Ollama server; PANDU calls its /api/chat endpoint.
OLLAMA_URL=http://localhost:11434
# Pull a model first, for example: ollama pull gemma3
OLLAMA_MODEL=gemma3:latest

# Local Whisper speech-to-text (the model downloads on the first transcription).
WHISPER_MODEL_SIZE=base

# ── Optional self-hosted endpoint ────────────────────────────
# Set AI_MODE=remote to prefer this endpoint. If it is unavailable,
# PANDU silently falls back to local Ollama.
# Endpoint must accept chat-completions-compatible JSON.
SELF_HOSTED_API_URL=
SELF_HOSTED_MODEL=
SELF_HOSTED_API_KEY=

# ── Frontend URL (for CORS) ──────────────────────────────────
# During development: http://localhost:5173
# After deploying: https://your-app.vercel.app
FRONTEND_URL=http://localhost:5173
