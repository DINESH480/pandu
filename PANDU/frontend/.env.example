# Copy to .env.local for local dev (Vite auto-loads .env.local)
# NEVER commit real .env files to GitHub

# Get these from: https://supabase.com → your project → Settings → API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Your FastAPI backend URL
# Local dev: http://localhost:8000
# Voice mode uses this API for Whisper transcription; spoken replies use browser speech
# and do not require an additional frontend key or TTS service.
VITE_API_URL=http://localhost:8000
